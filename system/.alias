##
## system
##

# move around dirs
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias -- -="cd -"

# Show/hide hidden files in Finder
alias show="defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder"
alias hide="defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder"

# Better ls & tree defaults
alias ls="gls -AGF --color --group-directories-first"
alias tree="tree -FC --filelimit=100 --dirsfirst --prune"

##
## tools
##

# shorter git
alias g="git"

# fuck
eval "$(thefuck --alias)"

# install global npm tools
alias npm-globals="npm install -g npm np gitmoji-cli"

# shorter nub
alias i="nub install"
alias r="nub run"
alias x="nubx"
